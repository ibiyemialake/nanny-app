# Copy to .env and fill in when you deploy. Nothing here is needed to try the app locally.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# 0 for real use on your server
DEBUG=0

# The address(es) people type to reach the app, comma-separated
ALLOWED_HOSTS=nanny.home,192.168.1.50
CSRF_TRUSTED_ORIGINS=http://nanny.home,http://192.168.1.50:8000

# Used to build invite links
SITE_URL=http://192.168.1.50:8000

TIME_ZONE=America/Toronto

# Nannies can only use the app from these networks (your home Wi-Fi).
# Find yours from your router or your phone's Wi-Fi details. Empty = no restriction.
STAFF_ALLOWED_NETWORKS=192.168.1.0/24

# Email for invites and late alerts. Leave EMAIL_HOST empty to print emails to the console instead.
# Gmail example: use an App Password, not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Home <you@gmail.com>

# Where the database lives (back this folder up). Docker sets this for you.
DATA_DIR=/srv/nanny-app/data

# Nightly backups: where they go, how many to keep. Docker writes them to ./backups.
BACKUP_DIR=/srv/nanny-app/backups
BACKUP_KEEP=14

# Docker only: the port the app is served on, and when the nightly backup runs.
HTTP_PORT=8088
BACKUP_TIME=03:00

# Set to 1 once the app is served over https:// so cookies are only sent securely.
USE_HTTPS=0
